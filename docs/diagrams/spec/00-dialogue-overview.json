{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "客服对话端到端运行流程",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "D:/SmartCS-Agent/docs/diagrams/00-dialogue-overview.html"
  },
  "lanes": [
    { "id": "client",   "label": "客户端" },
    { "id": "entry",    "label": "入口层" },
    { "id": "graph",    "label": "Agent 主图" },
    { "id": "fallback", "label": "静态话术与兜底", "variant": "exception" },
    { "id": "io",       "label": "出口与存储" }
  ],
  "phases": [
    { "id": "intake",   "label": "入口与前置", "fromCol": 1, "toCol": 2 },
    { "id": "route",    "label": "识别与路由", "fromCol": 3, "toCol": 3, "variant": "emphasis" },
    { "id": "dispatch", "label": "业务分派",   "fromCol": 4, "toCol": 4 },
    { "id": "outlet",   "label": "流式出口",   "fromCol": 5, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["user", "http_entry", "resolve", "cache", "router", "presale", "sse"],
  "nodes": [
    { "id": "user",           "lane": "client",   "col": 0, "type": "external", "label": "用户提问",       "sublabel": "浏览器 Chat UI",              "width": 132 },
    { "id": "http_entry",     "lane": "entry",    "col": 1, "type": "backend",  "label": "POST /api/langgraph/query", "sublabel": "main.py:216",        "width": 200 },
    { "id": "resolve",        "lane": "entry",    "col": 2, "type": "backend",  "label": "入口指代消解",   "sublabel": "pronoun_resolver.py", "tag": "多轮无条件 LLM", "width": 160 },
    { "id": "cache",          "lane": "io",       "col": 2, "type": "database", "label": "语义缓存查找",   "sublabel": "Redis",               "tag": "当前未启用",     "width": 160 },
    { "id": "router",         "lane": "graph",    "col": 3, "type": "backend",  "label": "意图识别与路由", "sublabel": "analyze_and_route_query",     "width": 190 },
    { "id": "presale",        "lane": "graph",    "col": 4, "type": "backend",  "label": "售前导购",       "sublabel": "create_research_plan",        "width": 190, "yOffset": -40 },
    { "id": "general",        "lane": "graph",    "col": 4, "type": "backend",  "label": "闲聊应答",       "sublabel": "respond_to_general_query",    "width": 190, "yOffset": 120 },
    { "id": "image",          "lane": "graph",    "col": 4, "type": "backend",  "label": "图片分析",       "sublabel": "create_image_query",          "width": 190, "yOffset": 40 },
    { "id": "clarify",        "lane": "graph",    "col": 4, "type": "backend",  "label": "意图澄清",       "sublabel": "clarify_node",                "width": 190, "yOffset": -120 },
    { "id": "static_replies", "lane": "fallback", "col": 4, "type": "security", "label": "静态话术组",     "sublabel": "风险/转人工/售后/投诉",       "width": 190 },
    { "id": "sse",            "lane": "io",       "col": 5, "type": "backend",  "label": "SSE 流式出口",   "sublabel": "process_stream",              "width": 160 }
  ],
  "edges": [
    { "id": "ask",         "from": "user",           "to": "http_entry" },
    { "id": "prep",        "from": "http_entry",     "to": "resolve",  "label": "取 history + image_path" },
    { "id": "lookup",      "from": "resolve",        "to": "cache",    "label": "消解后按 user_id 查" },
    { "id": "hit",         "from": "cache",          "to": "sse",      "label": "命中直接返回（当前未启用）", "variant": "dashed", "role": "return" },
    { "id": "miss",        "from": "cache",          "to": "router",   "label": "未命中" },
    { "id": "to_presale",  "from": "router",         "to": "presale",  "label": "type=presale",  "variant": "emphasis" },
    { "id": "to_general",  "from": "router",         "to": "general",  "label": "type=general" },
    { "id": "scope_guard", "from": "router",         "to": "general",  "label": "ScopeGuard 超范围", "variant": "dashed" },
    { "id": "to_clarify",  "from": "router",         "to": "clarify",  "label": "type=clarify" },
    { "id": "to_image",    "from": "router",         "to": "image",    "label": "type=image" },
    { "id": "to_static",   "from": "router",         "to": "static_replies", "label": "risk / 售后 / 投诉" },
    { "id": "out_presale", "from": "presale",        "to": "sse",      "variant": "emphasis" },
    { "id": "out_general", "from": "general",        "to": "sse" },
    { "id": "out_clarify", "from": "clarify",        "to": "sse" },
    { "id": "out_image",   "from": "image",          "to": "sse" },
    { "id": "out_static",  "from": "static_replies", "to": "sse" }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "图上标注的三处现状",
      "items": [
        "语义缓存 SEMANTIC_CACHE_ENABLED=false，整条链当前不生效",
        "stream_filter.py 拦截 analyze_and_route_query / planner 的内部推理 token",
        "风险拦截 / 转人工 / 售后 / 投诉 4 个节点为静态话术，不走 LLM"
      ]
    },
    {
      "dot": "cyan",
      "title": "入口关键事实",
      "items": [
        "thread_id 三态：新会话 / 多轮续聊 / 中断恢复",
        "PostgresSaver 检查点在每个节点执行后自动落库",
        "入口消解：首条无历史直通、纯语气词跳过，其余多轮一律调 LLM"
      ]
    }
  ]
}
