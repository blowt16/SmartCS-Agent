  "cards": [
    {
      "dot": "cyan",
      "title": "派生：唯一事实来源",
      "items": [
        "app/services/order_status.py —— 5 个订单状态 + 8 个运单状态都在这里",
        "SHIPMENT_TO_ORDER 是 8 → 5 的唯一映射表，多对一",
        "derive_order_fields 是唯一判断处：接口走 ORM、种子走 Core UPDATE，共用它"
      ]
    },
    {
      "dot": "amber",
      "title": "订单状态不可手改",
      "items": [
        "POST / PUT /api/admin/orders 不再接受 status / signed_date（传了 422，extra=forbid）",
        "新建订单恒为「处理中」；想推进订单 → 去改运单",
        "订单页的状态编辑入口已移除（工具条筛选项保留）"
      ]
    },
    {
      "dot": "rose",
      "title": "无运单的落点",
      "items": [
        "新建订单 / 删除运单 ⇒ 订单回「处理中」，签收日期清空",
        "NO_SHIPMENT_ORDER_STATUS 是这几处共用的常量",
        "signed_date 直接跟随运单（仅「已签收」取值），不各算各的"
      ]
    }
  ]
}
