# === LLM 服务配置 ===
# DeepSeek 在线模型
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 视觉模型
VISION_API_KEY=sk-your-vision-api-key
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o

# Ollama（如果用宿主机上的 Ollama，用 host.docker.internal 访问）
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:32b
OLLAMA_REASON_MODEL=deepseek-r1:32b
OLLAMA_AGENT_MODEL=qwen2.5:32b
OLLAMA_EMBEDDING_MODEL=bge-m3

# 模型服务选择
CHAT_SERVICE=deepseek
REASON_SERVICE=deepseek
AGENT_SERVICE=deepseek

# === 搜索 ===
SERPAPI_KEY=your-serpapi-key
SERPAPI_BASE_URL=https://serpapi.com/search
SEARCH_RESULT_COUNT=10
SEARCH_LANGUAGE=zh-CN
SEARCH_REGION=cn

# JWT
SECRET_KEY=change-this-to-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis 缓存
REDIS_CACHE_EXPIRE=3600
REDIS_CACHE_THRESHOLD=0.90
REDIS_CACHE_PREFIX=cache
REDIS_CACHE_MAX_SIZE=1000
REDIS_CACHE_CLEANUP_INTERVAL=3600

# Embedding
EMBEDDING_TYPE=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_THRESHOLD=0.90

# ChromaDB 向量库
VECTOR_DB_PATH=/app/llm_backend/vector_db
VECTOR_DB_COLLECTION=smartcs_agent_docs
CHROMADB_ANONYMIZED_TELEMETRY=false

# 分块参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 向量检索参数
VECTOR_SEARCH_TOP_K=10
HYBRID_RETRIEVAL_TOP_K=5
HYBRID_RETRIEVAL_TOP_N=20

# LLM 温度参数
LLM_TEMPERATURE=0.7
LLM_GRADER_TEMPERATURE=0.0
LLM_GENERATION_TEMPERATURE=0.8

# 流式响应
STREAM_DELAY=0.05

# 重排序
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=5
RERANKER_MAX_LENGTH=512

# 混合检索
RRF_FUSION_K=60
HYBRID_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# 预定义 Cypher
PREDEFINED_CYPHER_SIMILARITY_THRESHOLD=0.5

# 内存和 Token
MEMORY_CACHE_TTL=86400
CONVERSATION_HISTORY_MAX_RECORDS=5

# 相关性评分
RELEVANCE_GRADING_ENABLED=true
